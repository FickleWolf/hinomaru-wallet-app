{
  "name": "shackw-wallet-app",
  "version": "1.0.0",
  "description": "Shackw Wallet — non-custodial stablecoin wallet with gasless transfers via EIP-7702.",
  "author": "Shackw",
  "main": "./src/index.ts",
  "scripts": {
    "lint": "expo lint --fix && tsc --noEmit",
    "format": "npx prettier --write '**/*.{js,ts,tsx}'",
    "check": "yarn format && yarn lint",
    "start": "expo start",
    "start:tunnel": "expo start --dev-client --tunnel",
    "start:clear": "expo start -c",
    "dev:android": "dotenv -e .env -- expo run:android",
    "dev:ios": "dotenv -e .env -- expo run:ios",
    "build:android:apk:local": "yarn check && npx eas-cli build --platform android --profile android-internal --local",
    "build:android:apk": "yarn check && npx eas-cli build --platform android --profile android-internal",
    "build:android:aab": "yarn check && npx eas-cli build --platform android --profile production",
    "build:ios:dev-client": "yarn check && npx eas-cli build --platform ios --profile ios-internal",
    "build:ios:ipa": "yarn check && npx eas-cli build --platform ios --profile production --auto-submit",
    "creds:android": "npx eas-cli credentials --platform android",
    "creds:ios": "npx eas-cli credentials --platform ios",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/html-elements": "^0.12.5",
    "@expo/metro-runtime": "~55.0.10",
    "@gluestack-ui/core": "^3.0.16",
    "@gluestack-ui/utils": "^3.0.19",
    "@legendapp/motion": "^2.5.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-firebase/app": "23.5.0",
    "@react-native-firebase/app-check": "23.5.0",
    "@react-navigation/native": "^7.1.33",
    "@reown/walletkit": "^1.5.5",
    "@tanstack/react-form": "^1.29.1",
    "@tanstack/react-query": "^5.100.8",
    "@walletconnect/react-native-compat": "^2.23.9",
    "babel-plugin-module-resolver": "^5.0.3",
    "buffer": "^6.0.3",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "expo": "~55.0.19",
    "expo-application": "~55.0.14",
    "expo-build-properties": "~55.0.13",
    "expo-camera": "~55.0.16",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.15",
    "expo-dev-client": "~55.0.30",
    "expo-file-system": "~55.0.17",
    "expo-font": "~55.0.6",
    "expo-image-picker": "~55.0.19",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.14",
    "expo-router": "~55.0.13",
    "expo-secure-store": "~55.0.13",
    "expo-sharing": "~55.0.18",
    "expo-splash-screen": "~55.0.19",
    "expo-sqlite": "~55.0.15",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "~55.0.16",
    "fast-text-encoding": "^1.0.6",
    "lucide-react-native": "^0.525.0",
    "nativewind": "^4.2.3",
    "react": "19.2.0",
    "react-aria": "^3.47.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-mmkv": "^3.2.0",
    "react-native-passkeys": "^0.3.3",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-quick-crypto": "0.7.13",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.7.4",
    "react-stately": "^3.46.0",
    "tailwind-variants": "^3.2.2",
    "valibot": "^1.3.1",
    "viem": "^2.48.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/fast-text-encoding": "^1",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.14",
    "@types/react-dom": "~19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@walletconnect/jsonrpc-types": "^1.0.4",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~55.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.16",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react-test-renderer": "19.2.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3"
  },
  "private": true
}
